+    # 总表“材质描述”：先写材质描述原文，再按该行大类的模板顺序列出已填写的分类资料（“字段：值”，用“；”分隔）。
+    # 品牌/供应商有单独一列，这里不重复。
+    def soft_schedule_summary_material_text(row)
+      parts = []
+      description = row['material_description'].to_s.strip
+      parts << description unless description.empty?
+      extras = row['extra_fields'].is_a?(Hash) ? row['extra_fields'] : {}
+      top = soft_library_canonical_top_category(row['category'])
+      fields = Array((soft_schedule_template_fields rescue {})[top])
+      seen = {}
+      fields.each do |field|
+        key = field['key'].to_s
+        next if key.empty? || key == 'brand_supplier'
+        seen[key] = true
+        value = key == 'seat_height' ? soft_schedule_seat_height_value(row).to_s : extras[key].to_s
+        value = value.strip
+        next if value.empty? || value == description
+        parts << "#{field['label']}：#{value}"
+      end
+      # 大类改过之后，旧大类里填的资料也不能丢。
+      extras.each do |key, value|
+        next if seen[key.to_s] || key.to_s == 'brand_supplier'
+        text = value.to_s.strip
+        next if text.empty? || text == description
+        label = (soft_schedule_template_fields rescue {}).values.flatten.find { |field| field['key'].to_s == key.to_s }
+        parts << "#{label ? label['label'] : key}：#{text}"
+      end
+      parts.join('；')
+    rescue StandardError
+      row['material_description'].to_s
+    end
+
